# URL of the CodeGuage backend that performs the WakaTime OAuth token exchange
EXPO_PUBLIC_API_URL=http://localhost:8787

# Public WakaTime OAuth client id (created at https://wakatime.com/apps)
# This is a public identifier, not a secret. The client secret stays on the server.
EXPO_PUBLIC_WAKATIME_CLIENT_ID=waka_cli_xxxxxxxx
